.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  color: #333;
}

.required {
  color: #ff4d4f;
  font-size: 28rpx;
}

.optional {
  color: #999;
  font-size: 28rpx;
  font-weight: normal;
}

.exam-type-list {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.exam-type-item {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  border: 2rpx solid #e5e5e5;
  color: #666;
}

.exam-type-item.selected {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}

.subject-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.subject-item {
  padding: 20rpx 36rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  border: 2rpx solid #e5e5e5;
}

.subject-item.selected {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}

.picker {
  padding: 24rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #999;
  border: 2rpx solid #e5e5e5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.picker.selected {
  color: #333;
  border-color: #4A90D9;
}

.picker.disabled {
  background: #f5f5f5;
  color: #ccc;
}

.picker .arrow {
  font-size: 24rpx;
  color: #999;
}

.upload-area {
  width: 100%;
  height: 400rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.upload-placeholder .icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-placeholder .hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.uploading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading {
  color: #fff;
  font-size: 36rpx;
}

.tips {
  margin-top: 40rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.tips text {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}