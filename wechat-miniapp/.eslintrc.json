{
  "root": true,
  "env": {
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "globals": {
    "wx": "readonly",
    "App": "readonly",
    "Page": "readonly",
    "Component": "readonly",
    "Behavior": "readonly",
    "getApp": "readonly",
    "getCurrentPages": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", {"args": "none"}],
    "no-undef": "error",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", {"avoidEscape": true}]
  }
}
