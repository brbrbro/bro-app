page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}
.container {
  padding: 20rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 40rpx;
  text-align: center;
}